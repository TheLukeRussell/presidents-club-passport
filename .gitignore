# Logs
logs
*.log
npm-debug.log*

node_modules
dist
*.local

# Local tooling, keep it out of the repo
.hallmark/

# The real tracking sheet (and the Reps and Stamps CSVs saved from it for
# npm run import) has real names and emails, and this repo is public.
# Spreadsheets and env files never get committed, so dropping one in here by
# mistake can't leak it. The sample data is JSON.
*.csv
*.xls
*.xlsx
.env
.env.*
# The template has no secrets in it, so it is committed.
!.env.example
# npm run import writes the real sheet here: real names, public repo.
public/data/local.json

# Test coverage reports
coverage/

# Playwright output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Editor and OS junk
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?
