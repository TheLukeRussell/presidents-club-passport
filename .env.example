# Copy this to .env (gitignored) to run the attendance importer:
#   npm run import:attendance -- attendance.csv
# Never commit .env.
#
# Both values are in the Supabase dashboard under Project Settings, API Keys
# (and Data API for the URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# The service role key (or the new-style "secret" key, sb_secret_...). It
# skips row-level security and can change anything in the project, so it
# lives here only: never in public/config.js, front-end code or a commit.
# No VITE_ prefix on purpose, so Vite never puts it in the site's JavaScript.
SUPABASE_SERVICE_ROLE_KEY=
